---
import { url } from '../lib/url';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Search from '../components/Search.astro';
import { meta } from '../lib/data';
import { monthName } from '../lib/format';

interface Props {
  title: string;
  description: string;
  hideSearch?: boolean;
  /** Keep the page out of search results (and give it no canonical address). */
  noindex?: boolean;
  /** Parent pages for structured breadcrumbs, top first; the current page is added last. */
  crumbs?: { name: string; href: string }[];
  /** Short name of this page in breadcrumbs (defaults to the title). */
  crumbName?: string;
}
const { title, description, hideSearch = false, noindex = false, crumbs, crumbName = title } = Astro.props;
const m = meta();
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Yrkestrender' ? 'Yrkestrender – vad arbetsgivarna efterfrågar' : `${title} – Yrkestrender`;
const path = Astro.url.pathname;
// Structured data: the site itself on the home page, breadcrumbs on pages below it.
const home = new URL(url('/'), Astro.site).href;
const jsonLd =
  canonical.href === home
    ? { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Yrkestrender', url: home, inLanguage: 'sv-SE' }
    : crumbs && {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Yrkestrender', href: home }, ...crumbs, { name: crumbName, href: canonical.href }].map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: new URL(c.href, Astro.site).href,
        })),
      };
const nav = [
  { href: url('/yrken/'), label: 'Yrken' },
  { href: url('/kompetenser/'), label: 'Kompetenser och krav' },
  { href: url('/lan/'), label: 'Län' },
  { href: url('/jamfor/'), label: 'Jämför' },
  { href: url('/om/'), label: 'Om datan' },
];
---

<!doctype html>
<html lang="sv" data-base={url('')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="sv_SE" />
    <meta name="theme-color" content="#ffffff" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Light by default; dark only if the visitor chose it.
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Hoppa till innehållet</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={url('/')} aria-label="Yrkestrender, startsida"><Logo /></a>
        <nav aria-label="Huvudmeny">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          !hideSearch && (
            <div class="header-search">
              <Search variant="compact" />
            </div>
          )
        }
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap foot">
        <div class="foot-brand">
          <Logo size={24} />
          <p class="muted small">
            Vad arbetsgivarna efterfrågar i platsannonser, för varje yrke och län, sedan {m.years[0]}.
          </p>
        </div>
        <div>
          <h2 class="foot-h">Utforska</h2>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="foot-h">Data</h2>
          <p class="small">
            {`${m.totalAds.toLocaleString('sv-SE')} platsannonser från Arbetsförmedlingens Platsbanken, ${monthName(m.firstMonth)} – ${monthName(m.lastMonth)}. Källa: `}
            <a href="https://data.jobtechdev.se/annonser/historiska/">JobTech Development</a> (CC0). Uppdaterad {m.generated}.
          </p>
          <p class="small muted">Siffrorna visar vad annonser nämner, inte hur många som anställs. <a href={url('/om/')}>Så räknar vi</a>.</p>
        </div>
        <div>
          <h2 class="foot-h">Visning</h2>
          <button type="button" class="btn theme-toggle" data-theme-toggle aria-pressed="false">Mörkt läge</button>
          <p class="small muted src">
            <a href="https://github.com/Skraggan/yrkestrender">Källkod på GitHub</a>
          </p>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const sync = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        if (toggle) {
          toggle.setAttribute('aria-pressed', String(dark));
          toggle.textContent = dark ? 'Ljust läge' : 'Mörkt läge';
        }
      };
      sync();
      toggle?.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme !== 'dark';
        if (dark) document.documentElement.dataset.theme = 'dark';
        else delete document.documentElement.dataset.theme;
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch (e) {}
        sync();
      });

      // Hover readout for LineChart: nearest x value, all series.
      const fmt = (v: number | null, f: string) =>
        v == null
          ? '–'
          : f === 'pct'
            ? `${(v * 100).toLocaleString('sv-SE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} %`
            : f === 'index'
              ? Math.round(v).toLocaleString('sv-SE')
              : Math.round(v).toLocaleString('sv-SE');
      const label = (x: string) => {
        if (/^\d{4}-\d{2}$/.test(x)) {
          const m = ['jan', 'feb', 'mar', 'apr', 'maj', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
          return `${m[Number(x.slice(5)) - 1]} ${x.slice(0, 4)}`;
        }
        return x;
      };
      document.querySelectorAll<SVGSVGElement>('svg[data-chart]').forEach((svg) => {
        const data = JSON.parse(svg.dataset.chart!);
        const pad = JSON.parse(svg.dataset.pad!);
        const W = Number(svg.dataset.w),
          H = Number(svg.dataset.h),
          max = Number(svg.dataset.max),
          min = Number(svg.dataset.min || 0);
        const fig = svg.closest('figure')!;
        const out = fig.querySelector<HTMLElement>('.readout')!;
        const layer = svg.querySelector('.hover')!;
        const n = Math.max(1, data.x.length - 1);
        const colors = Array.from(svg.querySelectorAll<SVGPathElement>('path.line')).map((p) => p.getAttribute('stroke'));
        const show = (i: number) => {
          const r = svg.getBoundingClientRect();
          const cx = pad.l + ((W - pad.l - pad.r) * i) / n;
          let html = `<strong>${data.labelPrefix ?? ''}${label(data.x[i])}</strong>`;
          let dots = '';
          data.series.forEach((s: { label: string; values: (number | null)[] }, k: number) => {
            const v = s.values[i];
            html += `<span><i style="background:${colors[k]}"></i>${data.series.length > 1 ? s.label : ''}<b>${fmt(v, data.format)}</b></span>`;
            if (v != null) dots += `<circle cx="${cx}" cy="${pad.t + (H - pad.t - pad.b) * (1 - (v - min) / (max - min))}" r="4" fill="${colors[k]}"/>`;
          });
          layer.innerHTML = `<line x1="${cx}" x2="${cx}" y1="${pad.t}" y2="${H - pad.b}"/>${dots}`;
          out.innerHTML = html;
          out.classList.add('on');
          const left = (cx / W) * r.width;
          const w = out.offsetWidth;
          out.style.left = `${Math.min(r.width - w, Math.max(0, left + (left > r.width / 2 ? -w - 12 : 12)))}px`;
        };
        svg.addEventListener('pointermove', (ev) => {
          const r = svg.getBoundingClientRect();
          const px = ((ev.clientX - r.left) / r.width) * W;
          show(Math.max(0, Math.min(n, Math.round(((px - pad.l) / (W - pad.l - pad.r)) * n))));
        });
        svg.addEventListener('pointerleave', () => {
          layer.innerHTML = '';
          out.classList.remove('on');
        });
        // Keyboard: focus the chart, then arrow keys.
        let k = -1;
        svg.tabIndex = 0;
        svg.addEventListener('keydown', (ev) => {
          if (ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return;
          ev.preventDefault();
          k = k < 0 ? n : Math.max(0, Math.min(n, k + (ev.key === 'ArrowRight' ? 1 : -1)));
          show(k);
        });
        svg.addEventListener('blur', () => {
          layer.innerHTML = '';
          out.classList.remove('on');
        });
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--bg);
    padding: 0.5rem 1rem;
    z-index: 10;
  }
  .skip:focus {
    left: 0.5rem;
  }
  header.site {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 15;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
    padding-block: 0.75rem;
  }
  .brand {
    text-decoration: none;
    display: inline-flex;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.4rem;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--t-sm);
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--primary);
  }
  .header-search {
    margin-left: auto;
    width: min(100%, 18rem);
  }
  @media (max-width: 860px) {
    header.site {
      position: static;
    }
    .header-search {
      width: 100%;
      margin-left: 0;
    }
  }
  footer.site {
    border-top: 1px solid var(--rule);
    background: var(--surface);
    margin-top: 4rem;
    padding-block: 2.5rem 3rem;
  }
  .foot {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .foot-brand p {
    margin-top: 0.75rem;
  }
  .foot-h {
    font-size: var(--t-sm);
    font-weight: 650;
    margin-bottom: 0.6rem;
  }
  .foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: var(--t-sm);
  }
  .foot ul a {
    color: var(--ink-2);
  }
  .src {
    margin-top: 0.9rem;
  }
</style>
