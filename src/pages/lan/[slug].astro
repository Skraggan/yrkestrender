---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import LineChart from '../../components/LineChart.astro';
import Change from '../../components/Change.astro';
import { meta, nationalWindow, occById, region, regionIds, regionIndex, skillById } from '../../lib/data';
import { int, pct, pp, rel, windowLabel } from '../../lib/format';
import { monthRange, rollingIndex } from '../../lib/chart';
import { baseline, excess, volumeVsMarket } from '../../lib/trend';

export function getStaticPaths() {
  return regionIds().map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const r = region(slug!);
const m = meta();
const idx = regionIndex().find((x) => x.code === r.code)!;
const natL12 = nationalWindow('L12');
const natB12 = nationalWindow('B12');
const vsNation = volumeVsMarket(idx.L12, idx.B12, natL12, natB12);
const rank = [...regionIndex()].sort((a, b) => b.L12 - a.L12).findIndex((x) => x.code === r.code) + 1;

const BASE_YEAR = 2019;
const months = monthRange(`${m.occupationFirstYear}-01`, m.lastMonth);
const regIndex = rollingIndex(r.months, months, BASE_YEAR);
const natIndex = rollingIndex(m.nationalMonths, months, BASE_YEAR);
const recentLabel = m.partialLastYear ? `${m.years[m.years.length - 2]} och hittills ${m.years[m.years.length - 1]}` : String(m.years[m.years.length - 1]);

// Occupations: largest, typical for the county, and change against the county as a whole.
const regNow = r.occupations.reduce((a, o) => a + o.n, 0);
const regBefore = r.occupations.reduce((a, o) => a + o.prev, 0);
const occVs = (o: { n: number; prev: number }) => volumeVsMarket(o.n, o.prev, regNow, regBefore);
const biggest = r.occupations.slice(0, 12);
const maxN = Math.max(...biggest.map((o) => o.n), 1);
const typical = r.occupations.filter((o) => o.n >= 40 && (o.lq ?? 0) >= 1.5).sort((a, b) => (b.lq ?? 0) - (a.lq ?? 0)).slice(0, 12);
const maxLq = Math.max(...typical.map((o) => o.lq ?? 0), 1);

const compSkills = r.skills.filter((s) => skillById(s.s)?.kind === 'kompetens');
const base = baseline(compSkills);
const risingSkills = compSkills
  .filter((s) => s.n >= 30)
  .map((s) => ({ ...s, rel: excess(s.sh, s.sh3, base)! }))
  .sort((a, b) => b.rel - a.rel)
  .slice(0, 10);
---

<Base title={`Platsannonser i ${r.label}: yrken och kompetenser`} crumbName={r.label} crumbs={[{ name: 'Län', href: url('/lan/') }]} description={`Platsannonser i ${r.label}: yrkena med flest annonser, yrken som är typiska för länet och kompetenser som efterfrågas allt oftare.`}>
  <article>
    <header class="head-band">
      <div class="wrap">
        <p class="crumbs"><a href={url('/lan/')}>Län</a></p>
        <h1>{r.label}</h1>
        <dl class="facts">
          <div>
            <dt>Annonser senaste 12 mån</dt>
            <dd class="big">{int(idx.L12)}</dd>
            <dd class="sub">{`${windowLabel(m.windows.L12)}, plats ${rank} av ${regionIndex().length}`}</dd>
          </div>
          <div>
            <dt>Mot hela landet, 3 år</dt>
            <dd class="big"><Change value={vsNation} unit="rel" threshold={0.05} /></dd>
            <dd class="sub">Totalt {rel(idx.L12, idx.B12)}</dd>
          </div>
          {
            biggest[0] && (
              <div>
                <dt>Flest annonser</dt>
                <dd class="big-text">
                  <a href={url(`/yrken/${biggest[0].o}/`)}>{occById(biggest[0].o)?.label ?? biggest[0].o}</a>
                </dd>
                <dd class="sub">{int(biggest[0].n)} annonser, {recentLabel}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <div class="wrap">
      <section class="section">
        <div class="section-head">
          <h2>Efterfrågan över tid</h2>
          <p>{`Annonser de senaste tolv månaderna som index där ${BASE_YEAR} = 100. Grå linje: hela landet. Annonser utan angiven ort räknas inte.`}</p>
        </div>
        <LineChart
          title={`Platsannonser i ${r.label} jämfört med hela landet, index ${BASE_YEAR} = 100`}
          x={months}
          series={[
            { label: r.label, values: regIndex },
            { label: 'Hela landet', values: natIndex, dashed: true },
          ]}
          format="index"
          height={240}
          tickEvery={24}
          refLine={100}
        />
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Yrken i länet</h2>
          <p>{`${recentLabel}. Förändring på tre år räknas mot länet i stort (${rel(regNow, regBefore)}).`}</p>
        </div>
        <div class="grid-2">
          <div>
            <h3 class="sub-h">Flest annonser</h3>
            <ul class="bars">
              {biggest.map((o) => (
                <li>
                  <a href={url(`/yrken/${o.o}/`)}>{occById(o.o)?.label ?? o.o}</a>
                  <span class="bar" aria-hidden="true"><span style={`width:${((o.n / maxN) * 100).toFixed(1)}%`} /></span>
                  <span class="v">{int(o.n)}</span>
                  <Change value={occVs(o)} unit="rel" threshold={0.05} />
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="sub-h">Typiskt för länet</h3>
            <p class="muted small">Yrken som är vanligare här än i landet i stort. 2,0 betyder dubbelt så vanligt.</p>
            {
              typical.length ? (
                <ul class="bars lq">
                  {typical.map((o) => (
                    <li>
                      <a href={url(`/yrken/${o.o}/`)}>{occById(o.o)?.label ?? o.o}</a>
                      <span class="bar" aria-hidden="true"><span style={`width:${(((o.lq ?? 0) / maxLq) * 100).toFixed(1)}%`} /></span>
                      <span class="v">{o.lq?.toLocaleString('sv-SE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} ggr</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="muted">Inga yrken sticker ut tydligt.</p>
              )
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Kompetenser som ökar i länet</h2>
          <p>{`Andel av länets annonser, ${recentLabel} jämfört med tre år tidigare. Mot snittet: utöver hur kompetenser i länets annonser ändrats i genomsnitt.`}</p>
        </div>
        <table>
          <thead>
            <tr>
              <th scope="col">Kompetens</th>
              <th scope="col" class="num">Då</th>
              <th scope="col" class="num">Nu</th>
              <th scope="col" class="num">Mot snittet</th>
              <th scope="col" class="num tot">Totalt</th>
            </tr>
          </thead>
          <tbody>
            {risingSkills.map((s) => (
              <tr>
                <th scope="row"><a href={url(`/kompetenser/${s.s}/`)}>{skillById(s.s)?.name ?? s.s}</a></th>
                <td class="num muted">{pct(s.sh3)}</td>
                <td class="num">{pct(s.sh)}</td>
                <td class="num"><Change value={s.rel} unit="pp" /></td>
                <td class="num muted small tot">{pp(s.sh, s.sh3)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </div>
  </article>
</Base>

<style>
  .head-band {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding-block: 2rem 1.75rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    margin: 1.5rem 0 0;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .facts > div {
    background: var(--bg);
    padding: 0.9rem 1rem;
  }
  .facts dt {
    font-size: var(--t-xs);
    color: var(--muted);
    font-weight: 500;
  }
  .facts dd {
    margin: 0;
  }
  .facts .big {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 0.2rem;
  }
  .facts .big :global(.change) {
    font-size: 1.3rem;
    padding: 0.1rem 0.5rem;
  }
  .facts .big-text {
    font-size: var(--t-md);
    font-weight: 650;
    margin-top: 0.35rem;
    line-height: 1.3;
  }
  .facts .big-text a {
    color: var(--ink);
  }
  .facts .sub {
    font-size: var(--t-xs);
    color: var(--muted);
    margin-top: 0.3rem;
  }
  .sub-h {
    margin-bottom: 0.5rem;
  }
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bars li {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(2.5rem, 1fr) 3.4rem 3.8rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.42rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-sm);
  }
  .bars.lq li {
    grid-template-columns: minmax(0, 1.4fr) minmax(2.5rem, 1fr) 3.8rem;
  }
  .bars a {
    color: var(--ink);
    text-decoration: none;
  }
  .bars a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .bar {
    height: 8px;
    background: var(--surface-2);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--primary);
  }
  .v {
    text-align: right;
    font-weight: 600;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .bars li {
      grid-template-columns: minmax(0, 1fr) 3.4rem 3.8rem;
    }
    .bars.lq li {
      grid-template-columns: minmax(0, 1fr) 3.8rem;
    }
    .bar {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .tot {
      display: none;
    }
  }
</style>
