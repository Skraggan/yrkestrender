---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import LineChart from '../../components/LineChart.astro';
import { meta, occById, region, regionIds, skillById } from '../../lib/data';
import { int, pct, pp, ppValue, rel, relValue, signClass, trendClass } from '../../lib/format';
import { baseline, excess, volumeVsMarket } from '../../lib/trend';
import { monthRange, smooth } from '../../lib/chart';

export function getStaticPaths() {
  return regionIds().map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const r = region(slug!);
const m = meta();
const months = monthRange(m.firstMonth, m.lastMonth);
const monthly = smooth(months.map((x) => r.months[x] ?? 0), 1);
const recentLabel = m.partialLastYear ? `${m.years[m.years.length - 2]} och hittills ${m.years[m.years.length - 1]}` : String(m.years[m.years.length - 1]);

const biggest = r.occupations.slice(0, 15);
const typical = r.occupations.filter((o) => o.n >= 40 && (o.lq ?? 0) >= 1.5).sort((a, b) => (b.lq ?? 0) - (a.lq ?? 0)).slice(0, 12);
// Region totals now and three years earlier, for "against the county average".
const regNow = r.occupations.reduce((a, o) => a + o.n, 0);
const regBefore = r.occupations.reduce((a, o) => a + o.prev, 0);
const occVs = (o: { n: number; prev: number }) => volumeVsMarket(o.n, o.prev, regNow, regBefore);
const compSkills = r.skills.filter((s) => skillById(s.s)?.kind === 'kompetens');
const base = baseline(compSkills);
const risingSkills = compSkills
  .filter((s) => s.n >= 30)
  .map((s) => ({ ...s, rel: excess(s.sh, s.sh3, base)! }))
  .sort((a, b) => b.rel - a.rel)
  .slice(0, 10);
---

<Base title={r.label} description={`Platsannonser i ${r.label}: yrkena med flest annonser, yrken som är typiska för länet och kompetenser som efterfrågas allt oftare.`}>
  <article class="wrap">
    <header class="head">
      <p class="crumbs small"><a href={url('/lan/')}>Län</a></p>
      <h1>{r.label}</h1>
    </header>

    <section class="section">
      <div class="section-head">
        <h2>Annonser per månad</h2>
        <p>Glidande medelvärde över tre månader. Annonser utan angiven ort räknas inte.</p>
      </div>
      <LineChart title={`Platsannonser per månad i ${r.label}`} x={months} series={[{ label: 'Annonser', values: monthly }]} format="int" height={220} tickEvery={24} area />
    </section>

    <section class="section">
      <div class="grid-2">
        <div>
          <h2 class="h-sub">Flest annonser</h2>
          <p class="muted small">{`${recentLabel}. Förändring på tre år mot länet i stort (${rel(regNow, regBefore)}), totalt inom parentes.`}</p>
          <table>
            <thead>
              <tr>
                <th scope="col">Yrke</th>
                <th scope="col" class="num">Annonser</th>
                <th scope="col" class="num">Mot snittet</th>
              </tr>
            </thead>
            <tbody>
              {biggest.map((o) => (
                <tr>
                  <th scope="row"><a href={url(`/yrken/${o.o}/`)}>{occById(o.o)?.label ?? o.o}</a></th>
                  <td class="num">{int(o.n)}</td>
                  <td class="num">
                    <strong class={signClass(occVs(o), 0.05)}>{relValue(occVs(o))}</strong> <span class="muted small">({rel(o.n, o.prev)})</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div>
          <h2 class="h-sub">Typiskt för länet</h2>
          <p class="muted small">Yrken som utgör en större del av annonserna här än i landet. Index 2,0 betyder dubbelt så vanligt.</p>
          <table>
            <thead>
              <tr>
                <th scope="col">Yrke</th>
                <th scope="col" class="num">Index</th>
              </tr>
            </thead>
            <tbody>
              {typical.map((o) => (
                <tr>
                  <th scope="row"><a href={url(`/yrken/${o.o}/`)}>{occById(o.o)?.label ?? o.o}</a></th>
                  <td class="num">{o.lq?.toLocaleString('sv-SE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}</td>
                </tr>
              ))}
              {typical.length === 0 && (
                <tr>
                  <td colspan="2" class="muted">Inga yrken sticker ut tydligt.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="h-sub">Kompetenser som ökar i länet</h2>
      <p class="muted small">{`Andel av länets annonser, ${recentLabel} jämfört med tre år tidigare. Mot snittet = utöver hur kompetenser i länets annonser ökat i genomsnitt.`}</p>
      <table>
        <thead>
          <tr>
            <th scope="col">Kompetens</th>
            <th scope="col" class="num">Då</th>
            <th scope="col" class="num">Nu</th>
            <th scope="col" class="num">Mot snittet</th>
            <th scope="col" class="num">Totalt</th>
          </tr>
        </thead>
        <tbody>
          {risingSkills.map((s) => (
            <tr>
              <th scope="row"><a href={url(`/kompetenser/${s.s}/`)}>{skillById(s.s)?.name ?? s.s}</a></th>
              <td class="num">{pct(s.sh3)}</td>
              <td class="num">{pct(s.sh)}</td>
              <td class={`num strong ${signClass(s.rel)}`}><span class="delta-mark">{ppValue(s.rel)}</span></td>
              <td class={`num muted small ${trendClass(s.sh, s.sh3)}`}>{pp(s.sh, s.sh3)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </article>
</Base>

<style>
  .head {
    padding-block: 2.5rem 1.5rem;
  }
  .crumbs a {
    color: var(--graphite);
  }
  .crumbs {
    margin-bottom: 0.75rem;
  }
  .h-sub {
    font-size: var(--t-lg);
    margin-bottom: 0.5rem;
  }
  th[scope='row'] {
    font-weight: 400;
    font-size: var(--t-base);
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  th[scope='row'] a {
    color: var(--ink);
  }
  .delta-mark {
    padding: 0.05rem 0.3rem;
    border-radius: 2px;
  }
  .strong {
    font-weight: 700;
  }
</style>
