  }
  .prose h1 {
    margin-bottom: 1.25rem;
  }
  .prose h2 {
    font-size: var(--t-lg);
    margin: 2.25rem 0 0.75rem;
  }
  .lede {
    font-size: var(--t-md);
  }
  .prose ul {
    padding-left: 1.2rem;
  }
  .prose li {
    margin-bottom: 0.75rem;
    max-width: 68ch;
  }
</style>
