---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
---

<Base title="Sidan finns inte" description="Sidan finns inte." hideSearch>
  <div class="wrap nf">
    <h1>Sidan finns inte</h1>
    <p>Adressen kan ha ändrats. Sök efter ett yrke eller en kompetens i stället, eller gå till <a href={url('/yrken/')}>alla yrken</a>.</p>
    <div class="s"><Search variant="compact" /></div>
  </div>
</Base>

<style>
  .nf {
    padding-block: 4rem;
  }
  .nf p {
    margin-top: 1rem;
  }
  .s {
    max-width: 26rem;
  }
</style>
