---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import LineChart from '../components/LineChart.astro';
import SkillList from '../components/SkillList.astro';
import Change from '../components/Change.astro';
import { fields, KIND_NOUN, kinds, meta, nationalWindow, occupationIndex, regionIndex, skillIndex, type SkillIndexItem } from '../lib/data';
import { int, monthName, pct, rel, windowLabel } from '../lib/format';
import { monthRange, smooth } from '../lib/chart';
import { baseline, excess, volumeVsMarket } from '../lib/trend';

const m = meta();
const months = monthRange(m.firstMonth, m.lastMonth);
const monthly = smooth(months.map((x) => m.nationalMonths[x] ?? null), 1);
const natL12 = nationalWindow('L12');
const natB12 = nationalWindow('B12');
const natP12 = nationalWindow('P12');

// What changed most over three years, per kind, measured against the kind's average change.
const allSkills = skillIndex();
const kindBlocks = kinds().map((k) => {
  const items = allSkills.filter((s) => s.kind === k.id && s.sh != null && s.sh3 != null);
  const base = baseline(items);
  const scored = items.filter((s) => s.L12 >= 300 || s.B12 >= 300).map((s) => ({ s, r: excess(s.sh, s.sh3, base)! }));
  const toRow = ({ s, r }: { s: SkillIndexItem; r: number }) => ({
    id: s.id,
    name: s.name,
    href: url(`/kompetenser/${s.id}/`),
    share: s.sh,
    share3: s.sh3,
    rel: r,
    spark: s.spark,
  });
  return {
    kind: k,
    base,
    up: [...scored].sort((a, b) => b.r - a.r).slice(0, 6).map(toRow),
    down: [...scored].sort((a, b) => a.r - b.r).slice(0, 6).map(toRow),
  };
});

const occ = occupationIndex();
const vs = (o: { L12: number; B12: number }) => volumeVsMarket(o.L12, o.B12, natL12, natB12);
const biggest = occ.slice(0, 8);
const ranked = occ.filter((o) => o.B12 >= 300 && o.L12 >= 300).map((o) => ({ o, g: vs(o)! }));
const growing = [...ranked].sort((a, b) => b.g - a.g).slice(0, 8);
const shrinking = [...ranked].sort((a, b) => a.g - b.g).slice(0, 8);
const popular = ['Undersköterska', 'Elektriker', 'Grundskollärare', 'Lastbilsförare', 'Sjuksköterska', 'Systemutvecklare', 'Kock', 'Ekonomiassistent'];
const popularLinks = popular
  .map((t) => ({ label: t, o: occ.find((o) => o.titles.some((x) => x.startsWith(t)) || o.label.startsWith(t)) }))
  .filter((q) => q.o != null)
  .map((q) => ({ label: q.label, href: url(`/yrken/${q.o!.id}/`) }));
const allFields = fields();
const firstYear = m.years[0];
const nRegions = regionIndex().length;

const entries = [
  { q: 'Vad krävs för ett yrke?', a: `Kompetenser, körkort, utbildning och villkor i ${m.occupationCount} yrken.`, href: url('/yrken/'), cta: 'Välj yrke' },
  { q: 'Vilka yrken efterfrågar en kompetens?', a: `${allSkills.length} kompetenser och krav, och var de efterfrågas.`, href: url('/kompetenser/'), cta: 'Se kompetenser' },
  { q: 'Hur ser det ut där jag bor?', a: `Yrken och kompetenser som växer i Sveriges ${nRegions} län.`, href: url('/lan/'), cta: 'Välj län' },
  { q: 'Hur har något förändrats?', a: `Jämför upp till fem saker över tid, sedan ${firstYear}.`, href: url('/jamfor/'), cta: 'Jämför' },
];
---

<Base title="Yrkestrender" description={`Se vad arbetsgivare efterfrågar i platsannonser för varje yrke i Sverige, sedan ${firstYear}: kompetenser, krav, egenskaper och villkor.`} hideSearch>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-main">
        <h1>Vad efterfrågar arbetsgivarna?</h1>
        <p class="lede">
          {`Se vilka kompetenser, krav och villkor som står i platsannonserna för ${m.occupationCount} yrken, och hur det har förändrats sedan ${firstYear}.`}
        </p>
        <Search variant="hero" />
        <p class="popular">
          <span class="muted">Vanliga sökningar:</span>
          {popularLinks.map((q) => <a href={q.href}>{q.label}</a>)}
        </p>
      </div>
      <aside class="now panel" aria-labelledby="now-h">
        <h2 id="now-h" class="now-h">Arbetsmarknaden just nu</h2>
        <p class="now-num num">{int(natL12)}</p>
        <p class="now-label">platsannonser de senaste tolv månaderna</p>
        <dl class="now-facts">
          <div>
            <dt>Mot året innan</dt>
            <dd><Change value={natP12 ? natL12 / natP12 - 1 : null} unit="rel" /></dd>
          </div>
          <div>
            <dt>Mot tre år sedan</dt>
            <dd><Change value={natB12 ? natL12 / natB12 - 1 : null} unit="rel" /></dd>
          </div>
        </dl>
        <p class="small muted">{windowLabel(m.windows.L12)}. Källa: Platsbanken via JobTech.</p>
      </aside>
    </div>
  </section>

  <section class="wrap entries" aria-label="Utforska">
    {
      entries.map((e) => (
        <a class="entry" href={e.href}>
          <span class="entry-q">{e.q}</span>
          <span class="entry-a">{e.a}</span>
          <span class="entry-cta">{e.cta}</span>
        </a>
      ))
    }
  </section>

  <section class="section wrap" data-kind-tabs>
    <div class="section-head split">
      <div>
        <h2>Vad som ökar och minskar</h2>
        <p>
          De senaste tolv månaderna jämfört med samma period tre år tidigare. Förändringen räknas mot snittet för samma
          sort, eftersom annonserna med tiden nämner fler saker.
        </p>
      </div>
      <div class="tabs" role="tablist" aria-label="Sort">
        {
          kindBlocks.map((b, i) => (
            <button type="button" class="chip" role="tab" id={`tab-${b.kind.id}`} aria-controls={`panel-${b.kind.id}`} aria-selected={i === 0 ? 'true' : 'false'}>
              {b.kind.name}
            </button>
          ))
        }
      </div>
    </div>
    {
      kindBlocks.map((b, i) => (
        <div class="panel-k" role="tabpanel" id={`panel-${b.kind.id}`} aria-labelledby={`tab-${b.kind.id}`} hidden={i !== 0}>
          <div class="grid-2">
            <div>
              <h3 class="list-h">Nämns oftare</h3>
              <SkillList rows={b.up} caption={`${b.kind.name} som nämns oftare`} showBar={false} showSpark={false} showDiverge={false} />
            </div>
            <div>
              <h3 class="list-h">Nämns mer sällan</h3>
              <SkillList rows={b.down} caption={`${b.kind.name} som nämns mer sällan`} showBar={false} showSpark={false} showDiverge={false} />
            </div>
          </div>
          <p class="muted small base-note">
            {`Snittet: ${KIND_NOUN[b.kind.id]} nämns i genomsnitt ${pct(Math.abs(b.base - 1), 0)} ${b.base >= 1 ? 'oftare' : 'mer sällan'} än för tre år sedan.`}{' '}
            <a href={url(`/kompetenser/#${b.kind.id}`)}>Alla {KIND_NOUN[b.kind.id]}</a>
          </p>
        </div>
      ))
    }
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Yrken</h2>
      <p>{`Antal annonser ${windowLabel(m.windows.L12)}. Förändringen på tre år räknas mot hela arbetsmarknaden (${rel(natL12, natB12)}).`}</p>
    </div>
    <div class="occ-cols">
      <div>
        <h3 class="list-h">Flest annonser</h3>
        <ol class="occ">
          {
            biggest.map((o) => (
              <li>
                <a href={url(`/yrken/${o.id}/`)}>{o.label}</a>
                <span class="num muted">{int(o.L12)}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3 class="list-h">Växer mest mot snittet</h3>
        <ol class="occ">
          {
            growing.map(({ o, g }) => (
              <li>
                <a href={url(`/yrken/${o.id}/`)}>{o.label}</a>
                <Change value={g} unit="rel" />
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3 class="list-h">Minskar mest mot snittet</h3>
        <ol class="occ">
          {
            shrinking.map(({ o, g }) => (
              <li>
                <a href={url(`/yrken/${o.id}/`)}>{o.label}</a>
                <Change value={g} unit="rel" />
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Platsannonser per månad sedan {firstYear}</h2>
      <p>Glidande medelvärde över tre månader. Håll muspekaren över diagrammet för exakta tal.</p>
    </div>
    <LineChart
      title={`Antal publicerade platsannonser per månad, ${monthName(m.firstMonth)} till ${monthName(m.lastMonth)}`}
      x={months}
      series={[{ label: 'Annonser', values: monthly }]}
      format="int"
      height={240}
      tickEvery={24}
      area
      annotations={[
        { at: '2009-01', label: 'Finanskrisen' },
        { at: '2020-03', label: 'Pandemin' },
      ]}
    />
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Yrkesområden</h2>
      <p>Antal annonser de senaste tolv månaderna och förändring på tre år mot hela arbetsmarknaden.</p>
    </div>
    <ul class="fields">
      {
        allFields.map((f) => (
          <li>
            <a href={url(`/yrken/#${f.id}`)}>{f.label}</a>
            <span class="num muted">{int(f.L12)}</span>
            <Change value={vs(f)} unit="rel" />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-kind-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const select = (t: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${x.getAttribute('aria-controls')}`)!.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.tabIndex = i === 0 ? 0 : -1;
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });
  });
</script>

<style>
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }
  .hero-grid {
    display: grid;
    gap: 2rem 3.5rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 1fr);
    }
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.025em;
  }
  .hero .lede {
    font-size: var(--t-md);
    color: var(--ink-2);
    margin: 0.9rem 0 1.5rem;
    max-width: 52ch;
  }
  .popular {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-size: var(--t-sm);
    margin: 1rem 0 0;
  }
  .now {
    background: var(--bg);
    border: 1px solid var(--rule);
  }
  .now-h {
    font-size: var(--t-sm);
    font-weight: 650;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .now-num {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }
  .now-label {
    color: var(--ink-2);
    margin: 0.35rem 0 1rem;
  }
  .now-facts {
    display: flex;
    gap: 1.5rem;
    margin: 0 0 1rem;
  }
  .now-facts dt {
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .now-facts dd {
    margin: 0.2rem 0 0;
  }
  .entries {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    padding-block: 2rem 0.5rem;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
  }
  .entry:hover {
    border-color: var(--primary);
  }
  .entry-q {
    font-weight: 650;
    font-size: var(--t-md);
    line-height: 1.3;
  }
  .entry-a {
    color: var(--muted);
    font-size: var(--t-sm);
    flex: 1;
  }
  .entry-cta {
    color: var(--primary);
    font-weight: 600;
    font-size: var(--t-sm);
  }
  .entry:hover .entry-cta {
    text-decoration: underline;
  }
  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: flex-end;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .list-h {
    margin-bottom: 0.5rem;
  }
  .base-note {
    margin-top: 1rem;
  }
  .occ-cols {
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .occ {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rank;
  }
  .occ li {
    display: grid;
    grid-template-columns: 1.6rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .occ li::before {
    counter-increment: rank;
    content: counter(rank);
    color: var(--muted);
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
  }
  .fields li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
  }
  .occ a,
  .fields a {
    color: var(--ink);
    text-decoration: none;
  }
  .occ a:hover,
  .fields a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .fields {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2 24rem;
    column-gap: 3rem;
  }
  .fields a {
    flex: 1;
  }
</style>
