---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import LineChart from '../../components/LineChart.astro';
import Change from '../../components/Change.astro';
import TileMap from '../../components/TileMap.astro';
import { categoryName, KIND_NOUN, kindName, meta, occById, skill, skillById, skillIds, skillIndex } from '../../lib/data';
import { int, pct, pp, windowLabel } from '../../lib/format';
import { baseline, excess } from '../../lib/trend';

export function getStaticPaths() {
  return skillIds().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const s = skill(slug!);
const m = meta();
const years = m.years.map(String);
const qx = Object.keys(s.quarters);
const base = baseline(skillIndex().filter((x) => x.kind === s.kind));
const relChange = excess(s.share.L12, s.share.B12, base);
const firstYear = years[0];
const firstShare = s.years[firstYear] ?? 0;
const terms = s.terms.map((t) => t.replace(/\*$/, '…'));
const regionValues = Object.fromEntries(s.regions.map((r) => [r.r, r.sh]));
const maxCount = Math.max(...s.occupations.map((r) => r.n), 1);
const maxShareOcc = Math.max(...s.occupationsByShare.map((r) => r.sh), 0.0001);
const topOcc = s.occupationsByShare[0];
// Most distinctive companions (already ranked by the pipeline), shown by share. Near-100 % pairs are
// the same thing said twice (B-körkort is always also "körkort") and are left out.
const together = s.related.filter((r) => r.p < 0.95).slice(0, 12).sort((a, b) => b.p - a.p);
const description = `${s.name} nämns i ${pct(s.share.L12)} av alla platsannonser i Sverige. Se vilka yrken som efterfrågar det, hur det har förändrats sedan ${firstYear} och i vilka län.`;
---

<Base title={s.name} description={description}>
  <article>
    <header class="head-band">
      <div class="wrap">
        <p class="crumbs">
          <a href={url('/kompetenser/')}>Kompetenser och krav</a>{' / '}<a href={url(`/kompetenser/#${s.kind}`)}>{kindName(s.kind)}</a>{' / '}<a href={url(`/kompetenser/#${s.category}`)}>{categoryName(s.category)}</a>
        </p>
        <h1>{s.name}</h1>
        <dl class="facts">
          <div>
            <dt>Andel av alla annonser</dt>
            <dd class="big">{pct(s.share.L12)}</dd>
            <dd class="sub">{`${int(s.ads.L12)} annonser, ${windowLabel(m.windows.L12)}`}</dd>
          </div>
          <div>
            <dt>Mot snittet för {KIND_NOUN[s.kind]}, 3 år</dt>
            <dd class="big"><Change value={relChange} unit="pp" /></dd>
            <dd class="sub">Totalt {pp(s.share.L12, s.share.B12)}, från {pct(s.share.B12)}</dd>
          </div>
          <div>
            <dt>År {firstYear}</dt>
            <dd class="big">{firstShare < 0.0005 ? 'nästan 0' : pct(firstShare)}</dd>
            <dd class="sub">av alla annonser</dd>
          </div>
          {
            topOcc && (
              <div>
                <dt>Vanligast i</dt>
                <dd class="big-text">
                  <a href={url(`/yrken/${topOcc.o}/`)}>{occById(topOcc.o)?.label ?? topOcc.o}</a>
                </dd>
                <dd class="sub">{pct(topOcc.sh)} av yrkets annonser</dd>
              </div>
            )
          }
        </dl>
        <details class="terms">
          <summary>Så räknas det</summary>
          <p class="small">En annons räknas när den innehåller något av: {terms.join(', ')}.</p>
        </details>
      </div>
    </header>

    <div class="wrap">
      <section class="section">
        <div class="section-head">
          <h2>Andel av alla annonser över tid</h2>
          <p>Per kvartal sedan {firstYear}. Håll muspekaren över diagrammet för exakta värden. <a href={url(`/jamfor/#k=${s.id}`)}>Jämför med andra</a></p>
        </div>
        <LineChart title={`Andel av platsannonserna som nämner ${s.name}, per kvartal`} x={qx} series={[{ label: s.name, values: qx.map((q) => s.quarters[q]) }]} format="pct" height={240} tickEvery={8} area />
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Vilka yrken efterfrågar det?</h2>
          <p>{windowLabel(m.windows.L12)}.</p>
        </div>
        <div class="grid-2">
          <div>
            <h3 class="sub-h">Flest annonser</h3>
            <ul class="bars">
              {s.occupations.slice(0, 12).map((r) => (
                <li>
                  <a href={url(`/yrken/${r.o}/`)}>{occById(r.o)?.label ?? r.o}</a>
                  <span class="bar" aria-hidden="true"><span style={`width:${((r.n / maxCount) * 100).toFixed(1)}%`} /></span>
                  <span class="v">{int(r.n)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="sub-h">Störst andel av yrkets annonser</h3>
            <ul class="bars">
              {s.occupationsByShare.slice(0, 12).map((r) => (
                <li>
                  <a href={url(`/yrken/${r.o}/`)}>{occById(r.o)?.label ?? r.o}</a>
                  <span class="bar" aria-hidden="true"><span style={`width:${((r.sh / maxShareOcc) * 100).toFixed(1)}%`} /></span>
                  <span class="v">{pct(r.sh)}</span>
                </li>
              ))}
            </ul>
            <p class="muted small">Yrken med minst 20 sådana annonser.</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="map-grid">
          <div>
            <div class="section-head">
              <h2>Var efterfrågas det?</h2>
              <p>Andel av länets annonser det senaste året.</p>
            </div>
            <TileMap values={regionValues} format={(v) => pct(v)} title={`Andel annonser som nämner ${s.name}, per län`} legend="Lägre till högre andel, fem lika stora grupper" />
          </div>
          {
            together.length > 0 && (
              <div>
                <div class="section-head">
                  <h2>Nämns ofta tillsammans med</h2>
                  <p>{`Av annonserna som nämner ${s.name} de senaste två åren, andelen som också nämner följande.`}</p>
                </div>
                <ul class="bars">
                  {together.map((r) => {
                    const rs = skillById(r.s);
                    return rs ? (
                      <li>
                        <a href={url(`/kompetenser/${r.s}/`)}>{rs.name}</a>
                        <span class="bar" aria-hidden="true"><span style={`width:${(r.p * 100).toFixed(1)}%`} /></span>
                        <span class="v">{pct(r.p, 0)}</span>
                      </li>
                    ) : null;
                  })}
                </ul>
              </div>
            )
          }
        </div>
      </section>
    </div>
  </article>
</Base>

<style>
  .head-band {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding-block: 2rem 1.5rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1px;
    margin: 1.5rem 0 0;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .facts > div {
    background: var(--bg);
    padding: 0.9rem 1rem;
  }
  .facts dt {
    font-size: var(--t-xs);
    color: var(--muted);
    font-weight: 500;
  }
  .facts dd {
    margin: 0;
  }
  .facts .big {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 0.2rem;
  }
  .facts .big :global(.change) {
    font-size: 1.3rem;
    padding: 0.1rem 0.5rem;
  }
  .facts .big-text {
    font-size: var(--t-md);
    font-weight: 650;
    margin-top: 0.35rem;
    line-height: 1.3;
  }
  .facts .big-text a {
    color: var(--ink);
  }
  .facts .sub {
    font-size: var(--t-xs);
    color: var(--muted);
    margin-top: 0.3rem;
  }
  .terms {
    margin-top: 1rem;
  }
  .terms summary {
    cursor: pointer;
    font-size: var(--t-sm);
    color: var(--primary);
    font-weight: 600;
  }
  .terms p {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }
  .sub-h {
    margin-bottom: 0.5rem;
  }
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bars li {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(3rem, 1fr) 3.6rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.42rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-sm);
  }
  .bars a {
    color: var(--ink);
    text-decoration: none;
  }
  .bars a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .bar {
    height: 8px;
    background: var(--surface-2);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--primary);
  }
  .v {
    text-align: right;
    font-weight: 600;
    white-space: nowrap;
  }
  .map-grid {
    display: grid;
    gap: 2.5rem 3.5rem;
  }
  @media (min-width: 900px) {
    .map-grid {
      grid-template-columns: 22rem 1fr;
    }
  }
</style>
