---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import LineChart from '../../components/LineChart.astro';
import SkillList from '../../components/SkillList.astro';
import Change from '../../components/Change.astro';
import TileMap from '../../components/TileMap.astro';
import { categories, fieldById, KIND_NOUN, kinds, meta, nationalWindow, occById, occupation, occupationIds, regionByCode, skillById, type OccSkill } from '../../lib/data';
import { int, pct, rel, windowLabel } from '../../lib/format';
import { monthRange, rollingIndex, smooth } from '../../lib/chart';
import { baseline, excess, volumeVsMarket } from '../../lib/trend';

export function getStaticPaths() {
  return occupationIds().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const o = occupation(slug!);
const m = meta();
const field = fieldById(occById(o.id)?.field ?? null);
const occFirst = m.occupationFirstYear;
const years = m.years.filter((y) => y >= occFirst).map(String);
const lastYear = String(m.years[m.years.length - 1]);
const condYear = m.partialLastYear ? lastYear : lastYear;

// ---- Demand: occupation against the whole job market
const months = monthRange(`${occFirst}-01`, m.lastMonth);
const BASE_YEAR = 2019;
const occIndex = rollingIndex(o.months, months, BASE_YEAR);
const mktIndex = rollingIndex(m.nationalMonths, months, BASE_YEAR);
const hasIndex = occIndex.some((v) => v != null);
const monthly = smooth(months.map((x) => o.months[x] ?? 0), 1);
const natL12 = nationalWindow('L12');
const vsMarket3 = volumeVsMarket(o.ads.L12, o.ads.B12, natL12, nationalWindow('B12'));
const vsMarket1 = volumeVsMarket(o.ads.L12, o.ads.P12, natL12, nationalWindow('P12'));
const lastOcc = [...occIndex].reverse().find((v) => v != null);
const lastMkt = [...mktIndex].reverse().find((v) => v != null);

// ---- Items grouped by kind; each kind's trend is measured against its own average.
const known = o.skills.filter((s) => skillById(s.s) && s.sh != null);
const cats = categories();
const sections = kinds().map((k) => {
  const items = known.filter((s) => skillById(s.s)!.kind === k.id);
  const base = baseline(items);
  const rows = items.map((s: OccSkill) => {
    const sk = skillById(s.s)!;
    return {
      id: s.s,
      name: sk.name,
      href: url(`/kompetenser/${s.s}/`),
      share: s.sh,
      share3: s.sh3,
      rel: excess(s.sh, s.sh3, base),
      spark: years.map((y) => s.y[y] ?? null),
      category: sk.category,
      n: s.n,
    };
  });
  const present = new Set(rows.map((r) => r.category));
  const filters = cats.filter((c) => c.kind === k.id && present.has(c.id)).map((c) => [c.id, c.name] as [string, string]);
  return { kind: k, rows, filters, base };
});
const intro: Record<string, string> = {
  kompetens: 'Vad man ska kunna: yrkeskunskaper, verktyg och arbetssätt.',
  krav: 'Förutsättningar för att få jobbet: körkort, behörigheter, utbildning, legitimation, språk och kontroller.',
  egenskap: 'Personliga egenskaper som arbetsgivarna skriver att de söker.',
  villkor: 'Vad arbetsgivarna erbjuder och hur anställningen ser ut.',
};

// ---- Facts
const cond = o.conditions[condYear] ?? o.conditions[years[years.length - 2]] ?? null;
const topRegion = o.regions[0] ? regionByCode(o.regions[0].r) : undefined;
const regionTotal = o.regions.reduce((a, r) => a + r.n, 0);
const regionValues = Object.fromEntries(o.regions.map((r) => [r.r, r.n]));
const typical = o.regions.filter((r) => (r.lq ?? 0) >= 1.3 && r.n >= 20).slice(0, 5);

// Conditions over time: a few years spread over the period, plus the latest.
const condYears = years.filter((y) => o.conditions[y] && Object.values(o.conditions[y]).some((v) => v != null));
const pickYears = condYears.length <= 6 ? condYears : [...condYears.filter((_, i) => i % Math.ceil(condYears.length / 5) === 0).slice(0, 5), condYears[condYears.length - 1]];
const condRows: [keyof (typeof o.conditions)[string], string][] = [
  ['fulltime', 'Heltid'],
  ['permanent', 'Tillsvidareanställning'],
  ['experience', 'Kräver erfarenhet'],
  ['english', 'Annonsen är på engelska'],
];
const topSkills = sections[0].rows.slice(0, 3);
const description = `Vad krävs för att jobba som ${o.titles[0]?.t.toLowerCase() ?? o.label.toLowerCase()}? ${topSkills.map((s) => `${s.name} (${pct(s.share)})`).join(', ')}, krav, villkor och efterfrågan sedan ${occFirst}.`;
---

<Base title={o.label} description={description}>
  <article>
    <header class="occ-head">
      <div class="wrap">
        <p class="crumbs">
          <a href={url('/yrken/')}>Yrken</a>
          {field && <> / <a href={url(`/yrken/#${field.id}`)}>{field.label}</a></>}
        </p>
        <h1>{o.label}</h1>
        {
          o.titles.length > 0 && (
            <p class="titles">
              <span class="muted">Vanliga titlar i annonserna:</span> {o.titles.slice(0, 8).map((t) => t.t).join(', ')}
            </p>
          )
        }
        <dl class="facts">
          <div>
            <dt>Annonser senaste 12 mån</dt>
            <dd class="big tnum">{int(o.ads.L12)}</dd>
            <dd class="sub">{windowLabel(m.windows.L12)}</dd>
          </div>
          <div>
            <dt>Efterfrågan mot marknaden, 3 år</dt>
            <dd class="big"><Change value={vsMarket3} unit="rel" threshold={0.05} /></dd>
            <dd class="sub">Totalt {rel(o.ads.L12, o.ads.B12)}, 1 år: <Change value={vsMarket1} unit="rel" threshold={0.05} /></dd>
          </div>
          {
            topRegion && (
              <div>
                <dt>Flest annonser</dt>
                <dd class="big-text">{topRegion.label}</dd>
                <dd class="sub">{pct(o.regions[0].n / regionTotal, 0)} av yrkets annonser</dd>
              </div>
            )
          }
          {
            cond && (
              <div>
                <dt>Anställningen{m.partialLastYear ? ` (${condYear})` : ''}</dt>
                <dd class="list">
                  <span>Heltid <b>{pct(cond.fulltime, 0)}</b></span>
                  <span>Tillsvidare <b>{pct(cond.permanent, 0)}</b></span>
                  <span>Kräver erfarenhet <b>{pct(cond.experience, 0)}</b></span>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <nav class="in-page" aria-label="På den här sidan">
      <div class="wrap">
        <a href="#oversikt">Översikt</a>
        <a href="#efterfragan">Efterfrågan</a>
        {sections.filter((s) => s.rows.length).map((s) => <a href={`#${s.kind.id}`}>{s.kind.name}</a>)}
        <a href="#lan">Län</a>
        <a href="#liknande">Liknande yrken</a>
      </div>
    </nav>

    <div class="wrap">
      <section class="section" id="oversikt">
        <div class="section-head">
          <h2>Det här efterfrågas oftast</h2>
          <p>Andel av yrkets annonser de senaste tolv månaderna som nämner varje sak.</p>
        </div>
        <div class="profile">
          {
            sections.map((s) =>
              s.rows.length ? (
                <div class="profile-col">
                  <h3>{s.kind.name}</h3>
                  <ul>
                    {s.rows.slice(0, 5).map((r) => (
                      <li>
                        <a href={r.href}>{r.name}</a>
                        <span class="meter" aria-hidden="true">
                          <span style={`width:${((r.share ?? 0) * 100).toFixed(1)}%`} />
                        </span>
                        <span class="pv tnum">{pct(r.share, 0)}</span>
                      </li>
                    ))}
                  </ul>
                  <a class="more-link" href={`#${s.kind.id}`}>
                    Alla {s.rows.length} {KIND_NOUN[s.kind.id]}
                  </a>
                </div>
              ) : null,
            )
          }
        </div>
      </section>

      <section class="section" id="efterfragan">
        <div class="section-head">
          <h2>Efterfrågan över tid</h2>
          {
            hasIndex ? (
              <p>
                {`Antal annonser de senaste tolv månaderna, som index där ${BASE_YEAR} = 100. Grå linje: hela arbetsmarknaden. Just nu ligger yrket på ${Math.round(lastOcc ?? 0)} och marknaden på ${Math.round(lastMkt ?? 0)}.`}
              </p>
            ) : (
              <p>Antal annonser per månad, glidande medelvärde över tre månader.</p>
            )
          }
        </div>
        {
          hasIndex ? (
            <>
              <LineChart
                title={`Efterfrågan på ${o.label} jämfört med hela arbetsmarknaden, index ${BASE_YEAR} = 100`}
                x={months}
                series={[
                  { label: o.label, values: occIndex },
                  { label: 'Hela arbetsmarknaden', values: mktIndex, dashed: true },
                ]}
                format="index"
                height={260}
                tickEvery={24}
                refLine={100}
              />
              <details class="raw">
                <summary>Visa antal annonser per månad</summary>
                <LineChart title={`Platsannonser per månad för ${o.label}`} x={months} series={[{ label: 'Annonser', values: monthly }]} format="int" height={200} tickEvery={24} area />
              </details>
            </>
          ) : (
            <LineChart title={`Platsannonser per månad för ${o.label}`} x={months} series={[{ label: 'Annonser', values: monthly }]} format="int" height={220} tickEvery={24} area />
          )
        }
      </section>

      {
        sections.map((s, i) =>
          s.rows.length ? (
            <section class="section" id={s.kind.id}>
              <div class="section-head">
                <h2>{s.kind.name}</h2>
                <p>{intro[s.kind.id]}</p>
              </div>
              <SkillList rows={s.rows} caption={`${s.kind.name} i annonser för ${o.label}`} filters={s.filters} limit={i === 0 ? 15 : 10} />
              <p class="muted small explain">
                {`Andel: del av yrkets annonser senaste tolv månaderna. Mot snittet: förändring på tre år utöver hur ${KIND_NOUN[s.kind.id]} i yrkets annonser ändrats i genomsnitt (${pct(Math.abs(s.base - 1), 0)} ${s.base >= 1 ? 'oftare' : 'mer sällan'}). Totalt: hela förändringen.`}
              </p>
            </section>
          ) : null,
        )
      }

      <section class="section" id="anstallning">
        <div class="section-head">
          <h2>Anställningen över tid</h2>
          <p>Andel av annonserna där uppgiften finns.</p>
        </div>
        <div class="scroll-x">
          <table class="cond">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">Villkor</span></th>
                {pickYears.map((y) => <th scope="col" class="num">{y === lastYear && m.partialLastYear ? `${y}*` : y}</th>)}
              </tr>
            </thead>
            <tbody>
              {condRows.map(([k, label]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {pickYears.map((y) => <td class="num tnum">{pct(o.conditions[y]?.[k] ?? null, 0)}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {m.partialLastYear && <p class="muted small">* Hittills i år.</p>}
      </section>

      <section class="section" id="lan">
        <div class="section-head">
          <h2>Var finns jobben?</h2>
          <p>Antal annonser per län det senaste året. Klicka på ett län för att se det.</p>
        </div>
        <div class="map-grid">
          <TileMap values={regionValues} format={(v) => int(v)} title={`Annonser för ${o.label} per län`} legend="Färre till fler annonser, fem lika stora grupper" />
          <div>
            <h3 class="sub-h">Där yrket är vanligast</h3>
            <p class="muted small">Län där yrket utgör en större del av annonserna än i landet i stort. 2,0 betyder dubbelt så vanligt.</p>
            {
              typical.length ? (
                <table>
                  <tbody>
                    {typical.map((r) => {
                      const reg = regionByCode(r.r);
                      return (
                        <tr>
                          <th scope="row">{reg ? <a href={url(`/lan/${reg.id}/`)}>{reg.label}</a> : r.r}</th>
                          <td class="num">{r.lq?.toLocaleString('sv-SE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} ggr</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              ) : (
                <p class="muted">Yrket är ungefär lika vanligt i alla län.</p>
              )
            }
            {
              o.employers.length > 0 && (
                <>
                  <h3 class="sub-h emp-h">Flest annonser de senaste tre åren</h3>
                  <table>
                    <tbody>
                      {o.employers.slice(0, 8).map((e) => (
                        <tr>
                          <th scope="row">{e.e}</th>
                          <td class="num tnum">{int(e.n)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="muted small">Bemanningsföretag annonserar ofta för andras räkning.</p>
                </>
              )
            }
          </div>
        </div>
      </section>

      {
        o.related.length > 0 && (
          <section class="section" id="liknande">
            <div class="section-head">
              <h2>Yrken med liknande krav</h2>
              <p>Yrken vars annonser efterfrågar liknande kompetenser och behörigheter. Bra att känna till inför ett yrkesbyte.</p>
            </div>
            <ul class="related">
              {o.related.map((r) => {
                const ro = occById(r.id);
                return ro ? (
                  <li>
                    <a href={url(`/yrken/${r.id}/`)}>{ro.label}</a>
                    <span class="muted small">{int(ro.L12)} annonser</span>
                    <span class="sim" aria-label={`Likhet ${Math.round(r.sim * 100)} av 100`}>
                      <span style={`width:${(r.sim * 100).toFixed(0)}%`} />
                    </span>
                  </li>
                ) : null;
              })}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</Base>

<style>
  .occ-head {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding-block: 2rem 1.75rem;
  }
  .titles {
    margin-top: 0.75rem;
    max-width: 80ch;
    color: var(--ink-2);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    margin: 1.5rem 0 0;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .facts > div {
    background: var(--bg);
    padding: 0.9rem 1rem;
  }
  .facts dt {
    font-size: var(--t-xs);
    color: var(--muted);
    font-weight: 500;
  }
  .facts dd {
    margin: 0;
  }
  .facts .big {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 0.2rem;
  }
  .facts .big :global(.change) {
    font-size: 1.3rem;
    padding: 0.1rem 0.5rem;
  }
  .facts .big-text {
    font-size: var(--t-lg);
    font-weight: 650;
    margin-top: 0.35rem;
  }
  .facts .sub {
    font-size: var(--t-xs);
    color: var(--muted);
    margin-top: 0.3rem;
  }
  .facts .sub :global(.change) {
    font-size: var(--t-xs);
  }
  .facts .list {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.35rem;
    font-size: var(--t-sm);
  }
  .facts .list span {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .in-page {
    position: sticky;
    top: 57px;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 860px) {
    .in-page {
      top: 0;
    }
  }
  .in-page .wrap {
    display: flex;
    gap: 1.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .in-page a {
    flex: none;
    padding-block: 0.7rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .in-page a:hover {
    color: var(--ink);
    border-bottom-color: var(--rule-strong);
  }
  :global(html) {
    scroll-padding-top: 7rem;
  }
  .profile {
    display: grid;
    gap: 2rem 2.5rem;
  }
  @media (min-width: 640px) {
    .profile {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .profile {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .profile-col h3 {
    font-size: var(--t-sm);
    color: var(--muted);
    font-weight: 650;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 0.25rem;
  }
  .profile ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .profile li {
    display: grid;
    grid-template-columns: 1fr 3.5rem 2.6rem;
    gap: 0.6rem;
    align-items: center;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-sm);
  }
  .profile li a {
    color: var(--ink);
    text-decoration: none;
  }
  .profile li a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .meter {
    height: 6px;
    background: var(--surface-2);
    border-radius: 3px;
    overflow: hidden;
  }
  .meter span {
    display: block;
    height: 100%;
    background: var(--primary);
  }
  .pv {
    text-align: right;
    font-weight: 600;
  }
  .more-link {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: var(--t-sm);
  }
  .raw {
    margin-top: 1.25rem;
  }
  .raw summary {
    cursor: pointer;
    color: var(--primary);
    font-size: var(--t-sm);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .explain {
    margin-top: 1rem;
    max-width: 80ch;
  }
  .cond th[scope='row'] {
    white-space: nowrap;
  }
  .map-grid {
    display: grid;
    gap: 2rem 3rem;
  }
  @media (min-width: 820px) {
    .map-grid {
      grid-template-columns: 22rem 1fr;
    }
  }
  .sub-h {
    font-size: var(--t-md);
    margin-bottom: 0.3rem;
  }
  .emp-h {
    margin-top: 2rem;
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 3rem;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
  }
  .related li {
    display: grid;
    grid-template-columns: 1fr auto 4rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .related a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .related a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .sim {
    height: 6px;
    background: var(--surface-2);
    border-radius: 3px;
    overflow: hidden;
  }
  .sim span {
    display: block;
    height: 100%;
    background: var(--primary-2);
  }
</style>
