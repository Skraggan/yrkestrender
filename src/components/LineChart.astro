---
// Line chart rendered as SVG at build time. The hover/keyboard readout is added
// by the script in Base.astro, which reads the data-* attributes.
import { linePath, niceStep, type Series } from '../lib/chart';

interface Annotation {
  at: string;
  label: string;
}
interface Props {
  x: string[]; // category labels ("2016", "2024-03"...)
  series: Series[];
  format?: 'pct' | 'int' | 'index';
  height?: number;
  tickEvery?: number; // show every n-th x label
  tickLabel?: (x: string) => string;
  annotations?: Annotation[];
  title: string; // accessible name
  area?: boolean;
  /** Draw a horizontal reference line (e.g. 100 on an index chart). */
  refLine?: number;
}

const { x, series, format = 'pct', height = 260, tickEvery, annotations = [], title, area = false, refLine } = Astro.props;
const tickLabel = Astro.props.tickLabel ?? ((s: string) => s.slice(0, 4));
const W = 720;
const H = height;
const pad = { l: 44, r: 12, t: 16, b: 28 };
const all = series.flatMap((s) => s.values.filter((v): v is number => v != null));
const dataMax = Math.max(...all, refLine ?? 0, 0);
const dataMin = format === 'index' ? Math.min(...all, refLine ?? Infinity) : 0;
const step = niceStep(Math.max(dataMax - dataMin, 1e-9) * 1.05, 4);
const min = format === 'index' ? Math.floor(dataMin / step) * step : 0;
const max = Math.ceil((dataMax * 1.02) / step) * step || step;
const yt: number[] = [];
for (let v = min; v <= max + step / 2; v += step) yt.push(v);
const n = Math.max(1, x.length - 1);
const xs = (i: number) => pad.l + ((W - pad.l - pad.r) * i) / n;
const ys = (v: number) => pad.t + (H - pad.t - pad.b) * (1 - (v - min) / (max - min));
const fmt = (v: number) =>
  format === 'pct'
    ? `${(v * 100).toLocaleString('sv-SE', { maximumFractionDigits: max < 0.05 ? 1 : 0 })} %`
    : format === 'index'
      ? Math.round(v).toLocaleString('sv-SE')
      : v >= 1000
        ? `${(v / 1000).toLocaleString('sv-SE', { maximumFractionDigits: 1 })} tn`
        : v.toLocaleString('sv-SE');
const every = tickEvery ?? Math.max(1, Math.ceil(x.length / 10));
const palette = ['var(--c1)', 'var(--c2)', 'var(--c3)', 'var(--c4)', 'var(--c5)'];
const color = (s: Series, i: number) => s.color ?? (s.dashed ? 'var(--ref)' : palette[i % palette.length]);
const payload = JSON.stringify({ x, format, series: series.map((s) => ({ label: s.label, values: s.values })) });
const lastIdx = (vals: (number | null)[]) => vals.map((v, i) => (v != null ? i : -1)).filter((i) => i >= 0).pop();
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} data-chart={payload} data-pad={JSON.stringify(pad)} data-w={W} data-h={H} data-max={max} data-min={min}>
    <title>{title}</title>
    {
      yt.map((t) => (
        <g class="grid">
          <line x1={pad.l} x2={W - pad.r} y1={ys(t)} y2={ys(t)} />
          <text x={pad.l - 8} y={ys(t) + 4} text-anchor="end">
            {fmt(t)}
          </text>
        </g>
      ))
    }
    {refLine != null && <line class="refline" x1={pad.l} x2={W - pad.r} y1={ys(refLine)} y2={ys(refLine)} />}
    {
      x.map((lbl, i) =>
        i % every === 0 ? (
          <text class="xt" x={xs(i)} y={H - 8} text-anchor="middle">
            {tickLabel(lbl)}
          </text>
        ) : null,
      )
    }
    {
      annotations.map((a) => {
        const i = x.indexOf(a.at);
        if (i < 0) return null;
        return (
          <g class="note">
            <line x1={xs(i)} x2={xs(i)} y1={pad.t} y2={H - pad.b} />
            <text x={xs(i) + 5} y={pad.t + 10}>
              {a.label}
            </text>
          </g>
        );
      })
    }
    {
      area && series[0] && (
        <path
          class="area"
          d={`${linePath(series[0].values, xs, ys)} L${xs(lastIdx(series[0].values) ?? 0)} ${ys(min)} L${xs(series[0].values.findIndex((v) => v != null))} ${ys(min)} Z`}
        />
      )
    }
    {
      series.map((s, i) => (
        <path class={`line${s.dashed ? ' ref' : ''}`} d={linePath(s.values, xs, ys)} stroke={color(s, i)} stroke-dasharray={s.dashed ? '5 4' : undefined} />
      ))
    }
    {
      series.map((s, i) => {
        const li = lastIdx(s.values);
        return li != null && !s.dashed ? <circle class="end" cx={xs(li)} cy={ys(s.values[li] as number)} r="3.5" fill={color(s, i)} /> : null;
      })
    }
    <g class="hover" aria-hidden="true"></g>
  </svg>
  {
    series.length > 1 && (
      <figcaption class="legend">
        {series.map((s, i) => (
          <span>
            <i class={s.dashed ? 'dash' : ''} style={`--k:${color(s, i)}`} />
            {s.label}
          </span>
        ))}
      </figcaption>
    )
  }
  <div class="readout" aria-hidden="true"></div>
</figure>

<style>
  .chart {
    margin: 0;
    position: relative;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  svg:focus-visible {
    outline-offset: 4px;
  }
  .grid line {
    stroke: var(--rule);
  }
  .grid text,
  .xt {
    fill: var(--muted);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
  }
  .refline {
    stroke: var(--ink-2);
    stroke-opacity: 0.45;
  }
  @media (max-width: 640px) {
    .grid text,
    .xt,
    .note text {
      font-size: 21px;
    }
  }
  .line {
    fill: none;
    stroke-width: 2.25;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .line.ref {
    stroke-width: 1.75;
  }
  .area {
    fill: var(--primary-soft);
  }
  .end {
    stroke: var(--bg);
    stroke-width: 2;
  }
  .note line {
    stroke: var(--rule-strong);
    stroke-dasharray: 2 3;
  }
  .note text {
    fill: var(--muted);
    font-size: 11px;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
    margin-top: 0.6rem;
  }
  .legend i {
    display: inline-block;
    width: 16px;
    height: 0;
    border-top: 2.5px solid var(--k);
    vertical-align: middle;
    margin-right: 0.4rem;
  }
  .legend i.dash {
    border-top-style: dashed;
  }
  .readout {
    position: absolute;
    top: 0;
    pointer-events: none;
    background: var(--bg);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    box-shadow: 0 6px 20px -10px rgb(0 0 0 / 0.35);
    font-size: var(--t-sm);
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius);
    display: grid;
    gap: 0.15rem;
    min-width: 9rem;
    opacity: 0;
    font-variant-numeric: tabular-nums;
  }
  .readout.on {
    opacity: 1;
  }
  .readout :global(span) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .readout :global(b) {
    margin-left: auto;
    padding-left: 0.9rem;
    font-weight: 650;
  }
  .readout :global(i) {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 2px;
  }
  :global(.hover line) {
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0.3;
  }
  :global(.hover circle) {
    stroke: var(--bg);
    stroke-width: 2;
  }
</style>
