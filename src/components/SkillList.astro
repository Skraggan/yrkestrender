---
// Ranked table of skills/requirements/etc.: share now, change against the
// average (main, with a diverging bar) and total change (secondary).
import Sparkline from './Sparkline.astro';
import Change from './Change.astro';
import { pct, pp } from '../lib/format';

export interface Row {
  id: string;
  name: string;
  href: string;
  share: number | null;
  share3: number | null;
  /** Change beyond the average of the same kind (see lib/trend.ts). */
  rel: number | null;
  spark: (number | null)[];
  note?: string;
  category?: string;
}
interface Props {
  rows: Row[];
  caption: string;
  shareLabel?: string;
  showBar?: boolean;
  /** Category chips above the table: [id, name] pairs. */
  filters?: [string, string][];
  /** Rows shown before "Visa alla". */
  limit?: number;
  showSpark?: boolean;
  showTotal?: boolean;
  /** Diverging bar next to the change badge (off in narrow lists). */
  showDiverge?: boolean;
}
const { rows, caption, shareLabel = 'Andel', showBar = true, filters = [], limit = 0, showSpark = true, showTotal = true, showDiverge = true } = Astro.props;
const maxShare = Math.max(...rows.map((r) => r.share ?? 0), 0.0001);
const maxRel = Math.max(...rows.map((r) => Math.abs(r.rel ?? 0)), 0.005);
const collapsed = limit > 0 && rows.length > limit;
---

<div class="skill-list" data-skill-list data-limit={limit || undefined}>
  {
    filters.length > 1 && (
      <div class="filters" role="group" aria-label="Visa kategori">
        <button type="button" class="chip" aria-pressed="true" data-filter="">
          Alla
        </button>
        {filters.map(([id, name]) => (
          <button type="button" class="chip" aria-pressed="false" data-filter={id}>
            {name}
          </button>
        ))}
      </div>
    )
  }
  <table class="skills">
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Namn</th>
        <th scope="col" class="num share-col">{shareLabel}</th>
        <th scope="col" class="rel-col">Mot snittet, 3 år</th>
        {showTotal && <th scope="col" class="num tot-col">Totalt</th>}
        {showSpark && <th scope="col" class="spark-col">Sedan start</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r, i) => (
          <tr data-cat={r.category} hidden={collapsed && i >= limit ? true : undefined}>
            <th scope="row">
              <a href={r.href}>{r.name}</a>
              {r.note && <span class="note">{r.note}</span>}
            </th>
            <td class="num share-col">
              <span class="share">
                {showBar && (
                  <span class="bar" aria-hidden="true">
                    <span style={`width:${(((r.share ?? 0) / maxShare) * 100).toFixed(1)}%`} />
                  </span>
                )}
                <span class="v">{pct(r.share)}</span>
              </span>
            </td>
            <td class="rel-col">
              <span class="rel">
                {showDiverge && (
                  <span class="div" aria-hidden="true">
                    {r.rel != null && (
                      <span class={r.rel >= 0 ? 'pos' : 'neg'} style={`width:${((Math.abs(r.rel) / maxRel) * 50).toFixed(1)}%`} />
                    )}
                  </span>
                )}
                <Change value={r.rel} unit="pp" />
              </span>
            </td>
            {showTotal && <td class="num tot-col muted">{pp(r.share, r.share3)}</td>}
            {showSpark && (
              <td class="spark-col">
                <Sparkline values={r.spark} />
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
  {
    collapsed && (
      <button type="button" class="btn more" data-more>
        Visa alla {rows.length}
      </button>
    )
  }
  <p class="empty muted" hidden>Inget i den här kategorin nämns tillräckligt ofta för att visas.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-skill-list]').forEach((root) => {
    const limit = Number(root.dataset.limit || 0);
    const rows = Array.from(root.querySelectorAll<HTMLTableRowElement>('tbody tr'));
    const more = root.querySelector<HTMLButtonElement>('[data-more]');
    const empty = root.querySelector<HTMLElement>('.empty')!;
    let filter = '';
    let expanded = false;
    const apply = () => {
      const matching = rows.filter((r) => !filter || r.dataset.cat === filter);
      rows.forEach((r) => (r.hidden = true));
      matching.forEach((r, i) => (r.hidden = !(expanded || filter || !limit || i < limit)));
      if (more) more.hidden = expanded || !!filter || matching.length <= limit;
      empty.hidden = matching.length > 0;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.filter || '';
        root.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      }),
    );
    more?.addEventListener('click', () => {
      expanded = true;
      apply();
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 700px) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: -1rem;
      padding: 0 1rem 0.4rem;
      scrollbar-width: thin;
    }
    .filters .chip {
      flex: none;
    }
  }
  .more {
    margin-top: 1rem;
  }
  .empty {
    margin-top: 1rem;
  }
  .note {
    display: block;
    font-size: var(--t-xs);
    color: var(--muted);
    font-weight: 400;
  }
  .share-col {
    width: 26%;
  }
  .share {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    justify-content: flex-end;
  }
  .share .v {
    min-width: 3.4rem;
    text-align: right;
  }
  .bar {
    flex: 1;
    max-width: 9rem;
    height: 8px;
    background: var(--surface-2);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }
  .bar span {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--primary);
    border-radius: 2px;
  }
  .rel-col {
    width: 24%;
  }
  .rel {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
  }
  .div {
    flex: 1;
    min-width: 3.5rem;
    max-width: 6rem;
    height: 8px;
    position: relative;
    background: linear-gradient(var(--rule-strong), var(--rule-strong)) center / 1px 100% no-repeat;
  }
  .div .pos,
  .div .neg {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 2px;
  }
  .div .pos {
    left: 50%;
    background: var(--up);
  }
  .div .neg {
    right: 50%;
    background: var(--down);
  }
  .tot-col {
    font-size: var(--t-sm);
  }
  .spark-col {
    width: 6.5rem;
  }
  @media (max-width: 760px) {
    .spark-col,
    .bar,
    .div {
      display: none;
    }
    .share-col,
    .rel-col {
      width: auto;
    }
  }
  @media (max-width: 440px) {
    .tot-col {
      display: none;
    }
  }
</style>
